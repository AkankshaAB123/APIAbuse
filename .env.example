# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DATABASE=api_threat_detection

# Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# JWT & Authentication Configuration
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gateway Configuration (Optional overrides)
# GATEWAY_PROTECTED_HOST=10.165.192.186
# TARGET_BASE_URL=http://10.165.192.186:8000
# GATEWAY_RATE_LIMIT_TTL_SECONDS=300
